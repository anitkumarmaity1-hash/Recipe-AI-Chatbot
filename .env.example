# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=
# Model code from the AI Studio models list. Verified on the docs page on 2026-11-08:
# gemini-3.5-flash-lite (stable, fast, cheap) or gemini-3.8-flash (stable, stronger).
GEMINI_MODEL=gemini-3.5-flash-lite
# gemini | lora
UNDERSTANDING_BACKEND=gemini
# Optional (defaults: 30 seconds, 2 retries on 429/5xx)
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_RETRIES=2